# This example lists required environment variables. Copy to .env and fill in.
# NEVER commit real keys. .env is gitignored.

# --- Meta Model API (required for Sentinel) ---
# Create a key at https://dev.meta.ai -> API keys. Server-side only.
META_API_KEY=
# Optional overrides (defaults shown):
# META_BASE_URL=https://api.meta.ai/v1
# META_MODEL=muse-spark-1.3
# META_TIMEOUT=45
# META_RETRIES=2

# --- Legacy Gemini path (optional, pre-hackathon /report endpoint) ---
GEMINI_API_KEY=

# --- Sentinel storage (optional) ---
# SENTINEL_DB=data/sentinel.db

# --- Frontend (optional) ---
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/alerts
